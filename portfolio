<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Haven - Online Book Shop</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation -->
    <header>
        <nav class="navbar">
            <h1 class="logo">📚 Book Haven</h1>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#books">Books</a></li>
                <li><a href="#categories">Categories</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>

            <button class="cart">🛒 Cart</button>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero">

        <div class="hero-text">
            <p class="small-title">WELCOME TO BOOK HAVEN</p>

            <h2>
                Discover Your Next
                <span>Great Read</span>
            </h2>

            <p>
                Explore thousands of amazing books from fiction and
                fantasy to science, history, and self-development.
            </p>

            <a href="#books" class="btn">Shop Books</a>
        </div>

        <div class="hero-book">
            <div class="book">
                <div class="book-cover">
                    <span>THE<br>ADVENTURE</span>
                    <small>A Great Story</small>
                </div>
            </div>
        </div>

    </section>

    <!-- Featured Books -->
    <section id="books" class="section">

        <div class="section-title">
            <p>OUR COLLECTION</p>
            <h2>Featured Books</h2>
        </div>

        <div class="book-container">

            <div class="book-card">
                <div class="book-image book-one">📖</div>
                <h3>The Great Adventure</h3>
                <p>John Smith</p>
                <div class="rating">★★★★★</div>
                <h4>$18.99</h4>
                <button>Add to Cart</button>
            </div>

            <div class="book-card">
                <div class="book-image book-two">📕</div>
                <h3>Dream Beyond</h3>
                <p>Emma Wilson</p>
                <div class="rating">★★★★★</div>
                <h4>$15.99</h4>
                <button>Add to Cart</button>
            </div>

            <div class="book-card">
                <div class="book-image book-three">📗</div>
                <h3>Green World</h3>
                <p>David Brown</p>
                <div class="rating">★★★★☆</div>
                <h4>$21.50</h4>
                <button>Add to Cart</button>
            </div>

            <div class="book-card">
                <div class="book-image book-four">📘</div>
                <h3>Ocean Stories</h3>
                <p>Sarah Miller</p>
                <div class="rating">★★★★★</div>
                <h4>$17.25</h4>
                <button>Add to Cart</button>
            </div>

        </div>
    </section>

    <!-- Categories -->
    <section id="categories" class="categories">

        <div class="section-title">
            <p>EXPLORE</p>
            <h2>Popular Categories</h2>
        </div>

        <div class="category-container">

            <div class="category">
                <span>📚</span>
                <h3>Fiction</h3>
                <p>1200+ Books</p>
            </div>

            <div class="category">
                <span>🧙</span>
                <h3>Fantasy</h3>
                <p>850+ Books</p>
            </div>

            <div class="category">
                <span>🔬</span>
                <h3>Science</h3>
                <p>650+ Books</p>
            </div>

            <div class="category">
                <span>💡</span>
                <h3>Self Help</h3>
                <p>500+ Books</p>
            </div>

        </div>
    </section>

    <!-- About -->
    <section id="about" class="about">

        <div class="about-image">
            📚
        </div>

        <div class="about-text">
            <p>ABOUT BOOK HAVEN</p>

            <h2>Your Gateway to a World of Stories</h2>

            <p>
                Book Haven is an online bookstore created for people
                who love reading. We bring together a carefully selected
                collection of books for readers of every age.
            </p>

            <p>
                Whether you're looking for an exciting novel, a useful
                educational book, or inspiration for personal growth,
                you'll find something here.
            </p>

            <a href="#books" class="btn">Explore Collection</a>
        </div>

    </section>

    <!-- Newsletter -->
    <section class="newsletter">

        <h2>Stay Updated</h2>

        <p>
            Subscribe to receive new book releases, special offers,
            and reading recommendations.
        </p>

        <div class="subscribe">
            <input type="email" placeholder="Enter your email">
            <button>Subscribe</button>
        </div>

    </section>

    <!-- Contact -->
    <section id="contact" class="contact">

        <div>
            <h2>Book Haven</h2>
            <p>Your favorite online destination for books.</p>
        </div>

        <div>
            <h3>Contact</h3>
            <p>📧 hello@bookhaven.com</p>
            <p>📞 +1 234 567 890</p>
        </div>

        <div>
            <h3>Follow Us</h3>
            <p>Facebook · Instagram · Twitter</p>
        </div>

    </section>

    <footer>
        <p>© 2026 Book Haven. All Rights Reserved.</p>
    </footer>

</body>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    color: #29231f;
    background: #fffaf4;
}

/* Navbar */

header {
    background: #fffaf4;
    border-bottom: 1px solid #eee1d3;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: #6b3f25;
    font-size: 24px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-links a {
    text-decoration: none;
    color: #44372f;
    font-weight: 500;
}

.nav-links a:hover {
    color: #b46b35;
}

.cart {
    border: none;
    padding: 10px 18px;
    border-radius: 20px;
    background: #6b3f25;
    color: white;
    cursor: pointer;
}

/* Hero */

.hero {
    min-height: 600px;
    max-width: 1200px;
    margin: auto;
    padding: 70px 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hero-text {
    max-width: 600px;
}

.small-title {
    color: #b46b35;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.hero h2 {
    font-size: 60px;
    line-height: 1.1;
    margin-bottom: 25px;
}

.hero h2 span {
    color: #b46b35;
}

.hero-text > p:not(.small-title) {
    color: #746960;
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    background: #6b3f25;
    color: white;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 6px;
}

.btn:hover {
    background: #4e2d1c;
}

/* Hero Book */

.hero-book {
    width: 350px;
    height: 400px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.book {
    width: 220px;
    height: 300px;
    background: #3e2418;
    padding: 12px;
    border-radius: 5px 12px 12px 5px;
    transform: rotate(-6deg);
    box-shadow: 20px 20px 30px rgba(0,0,0,0.2);
}

.book-cover {
    height: 100%;
    border: 2px solid #d5a56c;
    color: #f8dfb9;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.book-cover span {
    font-size: 30px;
    font-weight: bold;
    text-align: center;
}

.book-cover small {
    margin-top: 20px;
}

/* Sections */

.section {
    max-width: 1200px;
    margin: auto;
    padding: 80px 20px;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title p {
    color: #b46b35;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.section-title h2 {
    font-size: 36px;
    margin-top: 8px;
}

/* Books */

.book-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
}

.book-card {
    background: white;
    padding: 18px;
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.book-card:hover {
    transform: translateY(-8px);
}

.book-image {
    height: 220px;
    border-radius: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 70px;
    margin-bottom: 18px;
}

.book-one {
    background: #ead6c4;
}

.book-two {
    background: #e7caca;
}

.book-three {
    background: #d2e0d2;
}

.book-four {
    background: #cddbe9;
}

.book-card h3 {
    margin-bottom: 7px;
}

.book-card p {
    color: #777;
}

.rating {
    color: #e19a35;
    margin: 12px 0;
}

.book-card h4 {
    font-size: 20px;
    margin-bottom: 15px;
}

.book-card button {
    width: 100%;
    padding: 11px;
    border: none;
    border-radius: 5px;
    background: #6b3f25;
    color: white;
    cursor: pointer;
}

/* Categories */

.categories {
    background: #f2e7db;
    padding: 80px 20px;
}

.category-container {
    max-width: 1000px;
    margin: auto;

    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.category {
    background: white;
    text-align: center;
    padding: 30px 15px;
    border-radius: 10px;
}

.category span {
    font-size: 45px;
}

.category h3 {
    margin: 15px 0 5px;
}

.category p {
    color: #777;
}

/* About */

.about {
    max-width: 1100px;
    margin: auto;
    padding: 100px 20px;

    display: flex;
    align-items: center;
    gap: 70px;
}

.about-image {
    width: 400px;
    height: 350px;
    background: #6b3f25;
    color: white;

    display: flex;
    justify-content: center;
    align-items: center;

    font-size: 120px;
    border-radius: 10px;
}

.about-text {
    flex: 1;
}

.about-text > p:first-child {
    color: #b46b35;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.about-text h2 {
    font-size: 40px;
    margin: 15px 0 20px;
}

.about-text p {
    color: #70655d;
    line-height: 1.7;
    margin-bottom: 15px;
}

/* Newsletter */

.newsletter {
    text-align: center;
    padding: 70px 20px;
    background: #6b3f25;
    color: white;
}

.newsletter h2 {
    font-size: 35px;
    margin-bottom: 12px;
}

.newsletter p {
    margin-bottom: 25px;
}

.subscribe {
    display: flex;
    max-width: 500px;
    margin: auto;
}

.subscribe input {
    flex: 1;
    padding: 14px;
    border: none;
    outline: none;
}

.subscribe button {
    padding: 14px 22px;
    border: none;
    background: #b46b35;
    color: white;
    cursor: pointer;
}

/* Contact */

.contact {
    background: #2d211a;
    color: white;
    padding: 50px max(20px, calc((100% - 1100px) / 2));

    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
}

.contact h2,
.contact h3 {
    margin-bottom: 15px;
}

.contact p {
    color: #c7bdb6;
    margin-bottom: 8px;
}

/* Footer */

footer {
    text-align: center;
    background: #1e1612;
    color: #aaa;
    padding: 20px;
}

/* Responsive */

@media (max-width: 900px) {

    .nav-links {
        display: none;
    }

    .hero {
        flex-direction: column;
        text-align: center;
    }

    .hero h2 {
        font-size: 45px;
    }

    .book-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .category-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .about {
        flex-direction: column;
    }

    .about-image {
        width: 100%;
    }
}

@media (max-width: 500px) {

    .book-container,
    .category-container {
        grid-template-columns: 1fr;
    }

    .hero h2 {
        font-size: 38px;
    }

    .hero-book {
        width: 100%;
    }

    .about-text h2 {
        font-size: 30px;
    }

    .contact {
        grid-template-columns: 1fr;
    }

    .subscribe {
        flex-direction: column;
        gap: 8px;
    }
}
</html>
